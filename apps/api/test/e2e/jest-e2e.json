{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "@generated/(.*)$": "<rootDir>/prisma/generated/$1",
    "^src/(.*)$": "<rootDir>/src/$1",
    "^test/(.*)$": "<rootDir>/test/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
