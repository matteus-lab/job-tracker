{
  "name": "mood-tracker",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "// --- Infra ---": "",
    "db:up": "docker compose -f infra/postgres/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/postgres/docker-compose.yml down",
    "// --- API (apps/api) ---": "",
    "api:prisma:migrate": "npm run prisma:migrate -w @mood-tracker/api",
    "api:prisma:deploy": "npm run prisma:deploy -w @mood-tracker/api",
    "api:prisma:generate": "npm run prisma:generate -w @mood-tracker/api",
    "api:prisma:studio": "npm run prisma:studio -w @mood-tracker/api",
    "api:lint": "npm run lint -w @mood-tracker/api --",
    "api:dev": "npm run start:dev -w @mood-tracker/api",
    "api:test:unit": "npm run test:unit -w @mood-tracker/api --",
    "api:test:integration": "npm run test:integration -w @mood-tracker/api",
    "api:test:e2e": "npm run test:e2e -w @mood-tracker/api",
    "api:test:all": "npm run test:all -w @mood-tracker/api",
    "api:build": "npm run build -w @mood-tracker/api",
    "// --- Global tools ---": "",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
